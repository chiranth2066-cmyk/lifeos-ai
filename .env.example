# ==============================================================================
# LifeOS AI - Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or expose private keys to the client.
# ==============================================================================

# --- Supabase (Database, Authentication, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google Gemini API (Primary LLM - Server Only) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Optional External Integrations (Server Only) ---
# Web Search (Tavily or Serper). If omitted, clearly labeled mock search is used.
TAVILY_API_KEY=
SERPER_API_KEY=

# Weather API (Open-Meteo is used natively with no key required; optional OpenWeather override)
OPENWEATHER_API_KEY=

# Maps & Places API (OpenStreetMap Nominatim is used natively; optional Google Maps Places override)
GOOGLE_MAPS_API_KEY=

# --- Runtime Controls ---
# Set to "true" to enable clearly labeled local sandbox auth/storage when Supabase is not configured
LIFEOS_ALLOW_LOCAL_SANDBOX=true

